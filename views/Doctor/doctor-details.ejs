<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Details</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-5">
        <h1 class="mb-4">Doctor Details</h1>

        <h3>Name: <%= foundDoctor.name %></h3>
        <h4>Specialty: <%= foundDoctor.specialty %></h4>
        <h4>Years of Experience: <%= foundDoctor.yearsOfExperience %></h4>
        <br><br>
        <h4>Appointments</h4>
        <table class="table">
            <% if (foundDoctor.appointments.length > 0) { %>
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Patient Name</th>
                        <th>Reason</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% foundDoctor.appointments.forEach(appoint => { %>
                        <tr>
                            <td><%= new Date(appoint.date).toLocaleDateString() %></td>
                            <td><%= appoint.patientName %></td>
                            <td><%= appoint.reason %></td>
                            <td><a href="/appointments/<%= appoint._id %>" class="btn btn-info btn-sm">More Details</a></td>
                        </tr>
                    <% }) %>
                </tbody>
            <% } else { %>
                <tbody>
                    <tr>
                        <td colspan="4" class="text-center">No appointments found for this doctor.</td>
                    </tr>
                </tbody>
            <% } %>
        </table>
    </div>

</body>
</html>