<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Doctors</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>All Doctors</h1>
            <a href="/doctors/new" class="btn btn-success">Create Doctor</a>
        </div>
        
        <div class="row">
            <% allDoctors.forEach(doctor => { %>
                <div class="col-12 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><%= doctor.name %></h5>
                            <h6 class="card-subtitle mb-2 text-muted">Specialty: <%= doctor.specialty %></h6>
                            <p class="card-text">Experience: <%= doctor.yearsOfExperience %> years</p>
                            <a href="/doctors/<%= doctor._id %>" class="btn btn-primary">View Details</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    
</body>
</html>